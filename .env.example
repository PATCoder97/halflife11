# Docker Compose PostgreSQL
POSTGRES_DB=halflife
POSTGRES_USER=halflife
POSTGRES_PORT=5434
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Used when running Next.js directly outside Docker
DATABASE_URL=postgresql://halflife:replace-with-a-long-random-password@localhost:5432/halflife

# Auth.js / NextAuth.js
AUTH_SECRET=replace-with-output-of-openssl-rand-base64-32
NEXTAUTH_URL=https://halflife.example.com
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
ADMIN_EMAILS=admin@example.com,another-admin@example.com

# Reverse proxy and settlement display
APP_DOMAIN=halflife.example.com
WATER_UNIT_NAME=chai nước
